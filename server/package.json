    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.1.0",
    "@metidy/shared": "0.0.0",
    "@prisma/client": "^6.0.0",
    "fastify": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
